{
  "name": "org-hierarchy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/sdk",
    "packages/demo"
  ],
  "scripts": {
    "build:wasm": "cd packages/core && wasm-pack build --target web --out-dir ../sdk/src/wasm/pkg && cargo test export_rust_types --features ts-export",
    "build": "npm run build -w @org-hierarchy/sdk",
    "build:demo": "npm run build -w @org-hierarchy/demo",
    "dev": "npm run dev -w @org-hierarchy/demo",
    "test": "npm run test -w @org-hierarchy/sdk && npm run test -w @org-hierarchy/demo",
    "test:contract": "npm run test -w @org-hierarchy/sdk -- --run nodeInteractions.contract selection.test",
    "test:e2e:software-gl": "SOFTWARE_GL=1 playwright test e2e/renderer-choice.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "compare:nodes": "HARNESS=1 playwright test e2e/node-compare.spec.ts",
    "measure:window": "HARNESS=1 playwright test e2e/t88-window-cost.spec.ts --workers=1",
    "measure:motion": "HARNESS=1 playwright test e2e/t87-motion.spec.ts --workers=1",
    "test:verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run compare:nodes",
    "test:rust": "cd packages/core && cargo test",
    "typecheck": "npm run typecheck -w @org-hierarchy/sdk && npm run build:types -w @org-hierarchy/sdk && npm run typecheck -w @org-hierarchy/demo && tsc -p tsconfig.e2e.json",
    "test:prod": "playwright test --config playwright.prod.config.ts",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "measure:renderer": "HARNESS=1 playwright test e2e/t92-software-pan.spec.ts --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@ttsc/graph": "^0.28.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.74.0",
    "ttsc": "^0.28.3"
  },
  "engines": {
    "node": ">=20"
  }
}
