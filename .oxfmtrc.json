{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "bracketSpacing": true,
  "arrowParens": "always",
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules",
    "archive",
    "packages/sdk/src/wasm/pkg",
    "packages/core/target",
    "**/*.md",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml",
    "**/*.css"
  ]
}
