{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "react"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "archive/**",
    "packages/*/dist/**",
    "packages/sdk/src/wasm/pkg/**",
    "packages/sdk/src/wasm/generated/**",
    "packages/core/target/**",
    "**/*.d.ts"
  ],
  "rules": {
    "no-inline-comments": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "import/max-dependencies": "off",
    "no-underscore-dangle": "off",
    "import/no-unassigned-import": "off",
    "no-warning-comments": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-number-coercion": "off",
    "react/react-in-jsx-scope": "off",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "require-await": "off",
    "require-unicode-regexp": "off",
    "no-useless-return": "off",
    "no-promise-executor-return": "off",
    "import/no-self-import": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-dom-node-remove": "off",
    "unicorn/prefer-dom-node-append": "off",
    "unicorn/prefer-dom-node-dataset": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-at": "off",
    "unicorn/prefer-string-replace-all": "off",
    "unicorn/prefer-import-meta-properties": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-fill-with-reference-type": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-code-point": "off",
    "no-shadow": "off",
    "unicorn/no-object-as-default-parameter": "off",
    "unicorn/no-array-callback-reference": "off",
    "no-useless-spread": "off",
    "require-post-message-target-origin": "off",
    "prefer-add-event-listener": "off",
    "no-new-array": "off",
    "no-loop-func": "off",
    "prefer-top-level-await": "off",
    "prefer-single-call": "off",
    "prefer-math-trunc": "off",
    "no-unmodified-loop-condition": "off",
    "unicorn/no-lonely-if": "off",
    "no-immediate-mutation": "off",
    "max-depth": "off"
  }
}
